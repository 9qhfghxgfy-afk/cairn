# The Xcode project is generated from project.yml — never commit it.
Cairn.xcodeproj/
DerivedData/
build/
.swiftpm/
.netrc
*.xcuserstate
xcuserdata/
ResultBundles/
*.xcresult

.DS_Store
*.log

# Local-only secrets must never be tracked (tokens live in Keychain at runtime).
.env
*.tokens
Secrets/

# Personal signing values — Team ID, and optionally a personal bundle id — live here and must
# never be tracked. Config/Local.xcconfig.example is the tracked template; project.yml pulls this
# file in with an optional #include?, so CI, which has no such file, builds unsigned.
Config/Local.xcconfig
