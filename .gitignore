# The Xcode project is generated from project.yml — never commit it.
Cairn.xcodeproj/
DerivedData/
build/
# `swift test` writes a .build/ inside every package; `build/` above does not match it.
.build/
.swiftpm/
.netrc
*.xcuserstate
xcuserdata/
ResultBundles/
*.xcresult

.DS_Store
*.log
# The editor's own workspace settings are not part of the project.
.vscode/

# Local-only secrets must never be tracked (tokens live in Keychain at runtime).
.env
*.tokens
Secrets/

# Personal signing values — Team ID, and optionally a personal bundle id — live here and must
# never be tracked. Config/Local.xcconfig.example is the tracked template; project.yml pulls this
# file in with an optional #include?, so CI, which has no such file, builds unsigned.
Config/Local.xcconfig

# App/Info.plist is GENERATED by `xcodegen generate` from the `info:` block in project.yml, which is
# its source of truth. A hand edit to the plist is lost on the next generate, so it is ignored
# rather than tracked, and `git status` stays clean after a local build.
App/Info.plist
